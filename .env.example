# Copy to .env for Docker Compose. Do not commit .env.
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHOPREC_ADMIN_TOKEN=replace-with-a-random-token-of-at-least-24-characters
SHOPREC_PORT=8787
# Set only when running behind a reverse proxy, e.g. https://shoprec.example.org
SHOPREC_PUBLIC_ORIGIN=
